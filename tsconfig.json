{
	"exclude": [
		"node_modules",
		"dist",
	],
	"compilerOptions": {
		"target": "ESNext",

		"module": "ESNext",
		"moduleResolution": "bundler",

		"strict": true,
		"noImplicitReturns": true,
		"noUncheckedIndexedAccess": true,

		"noEmit": true,

		"lib": ["ESNext", "DOM", "DOM.Iterable"],

		"types": [
			"@total-typescript/ts-reset",
			"vite/client",
			"svelte",
			"@webgpu/types"
		]
	}
}